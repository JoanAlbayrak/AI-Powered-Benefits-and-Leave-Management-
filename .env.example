# Copy this file to .env and put your own key in it:
#   cp -n .env.example .env
# .env is gitignored. Never share your key or put real employee data in this project.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional settings (defaults shown). Check them with:
#   .venv/bin/python -m benefits_leave.readiness --live
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium            # low | medium | high | none
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_RETRIES=2
# ANTHROPIC_ACTION_BUDGET_SECONDS=90  # total model time for one action (10-110; keep under the page's 120 s timeout)
# BENEFITS_AI_DISABLED=0             # 1 = deterministic fallback only
